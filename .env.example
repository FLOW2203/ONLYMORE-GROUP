# ONLYMORE Group, environment variables

# Calendly investor booking (Commit 9)
# Format : https://calendly.com/florent-onlymore/rencontre-investisseur-30min
NEXT_PUBLIC_CALENDLY_URL=

# Plausible Analytics (Commit 16)
# Domaine declare dans Plausible (sans protocole)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=onlymore.group
# Source du script Plausible (tagged events + outbound links par defaut)
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.outbound-links.js

# Widget Actualites iNrCy (home, bas de page)
# URL d'embed complete, token signe pour le domaine onlymore.group.
# Vide = la section Actualites n'est pas rendue du tout.
NEXT_PUBLIC_INRCY_ACTUS_URL=
